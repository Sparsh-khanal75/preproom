# Copy to .env and change the secret before running anywhere but your laptop.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
POSTGRES_PASSWORD=preproom

# ollama (free, local), openai_compatible (e.g. Groq free tier) or mock (no AI, for demos/tests)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.1-8b-instant

# whisper (free, local, CPU) or mock
STT_PROVIDER=whisper
WHISPER_MODEL=small
